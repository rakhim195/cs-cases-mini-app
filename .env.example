# Telegram bot token issued by @BotFather. Leave empty to run the web API without the bot.
BOT_TOKEN=

# Bot username (without @) used to build referral links like https://t.me/<BOT_USERNAME>?start=r<USER_ID>.
BOT_USERNAME=

# Port for the FastAPI server (defaults to 8000).
PORT=8000

# Optional override for the async SQLAlchemy database URL.
# DATABASE_URL=sqlite+aiosqlite:///app.db

# Logging threshold for application logs (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO

# Public HTTPS base URL of the Mini App (e.g. a cloudflared/ngrok tunnel).
# Used for the "Открыть Кейсы" WebApp button and the bot menu button.
# WEBAPP_BASE_URL=https://example.trycloudflare.com

# Optional HTTP(S)/SOCKS proxy for reaching the Telegram API
# (e.g. http://127.0.0.1:10809 when api.telegram.org is blocked locally).
# TELEGRAM_PROXY=http://127.0.0.1:10809
